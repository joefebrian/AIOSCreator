# Copy to .env / apps/web/.env.local — never commit. Never put keys in the Obsidian vault.
# OpenAI-compatible Chat Completions. Provider is a config, not a lock.

LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.6
# Character Revamp only (optional):
# REVAMP_LLM_API_KEY=
# REVAMP_LLM_BASE_URL=https://openrouter.ai/api/v1
# REVAMP_LLM_MODEL=qwen/qwen3-coder:free

# Examples (uncomment one):
# OpenAI     LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=gpt-4.1-mini
# OpenRouter LLM_BASE_URL=https://openrouter.ai/api/v1        LLM_MODEL=qwen/qwen3-coder:free
# Prefer System → Settings for multiple keys. Env is fallback only.
# Groq       LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL=llama-3.3-70b-versatile
# Ollama     LLM_BASE_URL=http://127.0.0.1:11434/v1           LLM_API_KEY=ollama  LLM_MODEL=llama3.2

CREATOROS_MODE=local
DATABASE_URL=file:./data/db/creatoros.sqlite
MEDIA_ROOT=./data/media
COMFYUI_URL=http://127.0.0.1:8188
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
DEFAULT_DRAFT_HEIGHT=720
ALLOW_NATIVE_4K=false
